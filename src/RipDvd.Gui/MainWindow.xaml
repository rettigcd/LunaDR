<Window x:Class="RipDvd.Gui.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:c="clr-namespace:RipDvd.Gui.Controls"
		xmlns:g="clr-namespace:RipDvd.Gui"
		Title="LunaDR" Width="1280" Height="900" MinWidth="800" MinHeight="560">
	<Window.Resources>
		<g:NotConverter x:Key="Not" />
		<BooleanToVisibilityConverter x:Key="Visible" />
		<!-- Long track lists (Blu-ray) are cut with "…"; the tooltip shows all of it. -->
		<Style x:Key="Trimmed" TargetType="TextBlock">
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
			<Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
		</Style>
	</Window.Resources>
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />  <!-- drive picker, scan, disc name -->
			<RowDefinition Height="*" />     <!-- title list -->
			<RowDefinition Height="Auto" />  <!-- splitter -->
			<RowDefinition Height="*" />     <!-- cell map -->
			<RowDefinition Height="Auto" />  <!-- status line -->
			<RowDefinition Height="Auto" />  <!-- phase 2: output folder, file name, start -->
		</Grid.RowDefinitions>

		<!-- Phase 1: pick the drive; scanning starts by itself when a disc is inserted. -->
		<DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
			<TextBlock Text="Drive" VerticalAlignment="Center" Margin="0,0,8,0" />
			<ComboBox Width="240" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="Display" />
			<Button Content="Scan" Command="{Binding ScanCommand}" Margin="8,0,0,0" MinWidth="80" />
			<TextBlock Text="{Binding DiscName}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,0,0"
					   TextTrimming="CharacterEllipsis" />
		</DockPanel>

		<!-- All titles; short ones dimmed; duplicates and compilations explained in the Note column. -->
		<DataGrid Grid.Row="1" ItemsSource="{Binding Titles}" SelectedItem="{Binding SelectedTitle}"
				  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
				  CanUserReorderColumns="False" GridLinesVisibility="Horizontal">
			<DataGrid.RowStyle>
				<Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
					<Style.Triggers>
						<DataTrigger Binding="{Binding IsShort}" Value="True">
							<Setter Property="Opacity" Value="0.5" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</DataGrid.RowStyle>
			<DataGrid.Columns>
				<!-- Phase 2: check the titles to rip. A template column, so the checkbox works with one click although the grid is read-only. -->
				<DataGridTemplateColumn Header="Rip">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
									  IsEnabled="{Binding DataContext.IsRipping, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Not}}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTextColumn Header="Title" Binding="{Binding Number}" />
				<DataGridTextColumn Header="Length" Binding="{Binding Length}" />
				<DataGridTextColumn Header="Chapters" Binding="{Binding Chapters}" />
				<DataGridTextColumn Header="Size" Binding="{Binding Size}" />
				<DataGridTextColumn Header="Video" Binding="{Binding Video}" />
				<DataGridTextColumn Header="Audio" Binding="{Binding Audio}" MaxWidth="360" ElementStyle="{StaticResource Trimmed}" />
				<DataGridTextColumn Header="Subtitles" Binding="{Binding Subtitles}" MaxWidth="200" ElementStyle="{StaticResource Trimmed}" />
				<DataGridTextColumn Header="CC" Binding="{Binding Captions}" />
				<DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
			</DataGrid.Columns>
		</DataGrid>

		<GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Margin="0,4" />

		<!-- Cell map: which titles play which cells. -->
		<DockPanel Grid.Row="3" Visibility="{Binding HasCellMap, Converter={StaticResource Visible}}">
			<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
				<TextBlock Text="Cells" FontWeight="SemiBold" Margin="0,0,16,0" />
				<Rectangle Width="10" Height="10" Fill="#3B82F6" VerticalAlignment="Center" />
				<TextBlock Text=" played by one title" Margin="0,0,14,0" />
				<Rectangle Width="10" Height="10" Fill="#F59E0B" VerticalAlignment="Center" />
				<TextBlock Text=" shared by several titles" Margin="0,0,14,0" />
				<Rectangle Width="3" Height="10" Fill="#C0101010" VerticalAlignment="Center" />
				<TextBlock Text=" chapter start" Margin="0,0,14,0" />
				<TextBlock Text="Click a row to select its title; titles sharing its cells are highlighted." Opacity="0.7" />
			</StackPanel>
			<!-- G5: cells selected in the map, ripped on their own into one file. -->
			<DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" LastChildFill="True">
				<Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearCellsCommand}" Margin="6,0,0,0" />
				<Button DockPanel.Dock="Right" Content="Rip selected cells" Command="{Binding RipCellsCommand}" />
				<TextBlock Text="{Binding SelectedCellsText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
			</DockPanel>
			<TextBlock DockPanel.Dock="Bottom" Text="{Binding HoverInfo}" Margin="0,6,0,0" TextWrapping="Wrap" MinHeight="18" Opacity="0.85" />
			<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
				<c:CellMapView Map="{Binding CellMap}" SelectedTitle="{Binding SelectedTitleNumber}" SelectedCells="{Binding SelectedCells}"
							   RipCells="{Binding RipCells}" RipPosition="{Binding RipPosition}" RipCellFraction="{Binding RipCellFraction}" RipTitle="{Binding RipTitle}"
							   HoverText="{Binding HoverInfo, Mode=OneWayToSource}" HorizontalAlignment="Left" VerticalAlignment="Top" />
			</ScrollViewer>
		</DockPanel>

		<TextBlock Grid.Row="4" Text="{Binding Status}" Margin="0,8,0,0" Opacity="0.8" />

		<!-- Phase 2: where and under what name to save, then Start. -->
		<Border Grid.Row="5" Margin="0,10,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
			<StackPanel>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="3*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="2*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="Save to" VerticalAlignment="Center" Margin="0,0,8,0" />
					<TextBox Grid.Column="1" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
					<Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseCommand}" Margin="6,0,0,0" />
					<TextBlock Grid.Column="3" Text="File names" VerticalAlignment="Center" Margin="20,0,8,0" />
					<TextBox Grid.Column="4" Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
							 ToolTip="Files are named &quot;&lt;this&gt; - title NN.mkv&quot; (Blu-ray: &quot;- playlist NNNNN.mkv&quot;)" />
					<TextBlock Grid.Column="5" Text="{Binding FileNameSuffix}" VerticalAlignment="Center" Opacity="0.7" />
				</Grid>
				<DockPanel Margin="0,10,0,0" LastChildFill="True">
					<Button DockPanel.Dock="Left" Content="Select all" Command="{Binding SelectAllCommand}" />
					<Button DockPanel.Dock="Left" Content="None" Command="{Binding SelectNoneCommand}" Margin="6,0,0,0" />
					<Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" Margin="6,0,0,0" MinWidth="90" />
					<Button DockPanel.Dock="Right" Content="Start" Command="{Binding StartCommand}" MinWidth="110"
							Style="{DynamicResource AccentButtonStyle}" />
					<CheckBox DockPanel.Dock="Right" Content="Play a sound when done" IsChecked="{Binding PlaySoundWhenDone}"
							  VerticalAlignment="Center" Margin="0,0,16,0" />
					<TextBlock Text="{Binding RipStatus}" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis" />
				</DockPanel>

				<!-- Phase 3: progress of the current title and of all titles, then the files written. Appears when a rip starts. -->
				<StackPanel Margin="0,12,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource Visible}}">
					<TextBlock Text="{Binding TitleProgressText}" />
					<ProgressBar Value="{Binding TitleProgress, Mode=OneWay}" Maximum="1" Height="8" Margin="0,4,0,10" />
					<TextBlock Text="{Binding OverallProgressText}" />
					<ProgressBar Value="{Binding OverallProgress, Mode=OneWay}" Maximum="1" Height="8" Margin="0,4,0,10" />
					<DockPanel>
						<Button DockPanel.Dock="Right" Content="Open folder" Command="{Binding OpenFolderCommand}" VerticalAlignment="Top" Margin="12,0,0,0" />
						<ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
							<ItemsControl ItemsSource="{Binding Results}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal" Margin="0,1">
											<TextBlock Text="{Binding Icon}" Width="18" FontWeight="Bold" />
											<TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
										</StackPanel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</DockPanel>
				</StackPanel>
			</StackPanel>
		</Border>
	</Grid>
</Window>
