<Application x:Class="RipDvd.Gui.App"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
			 ThemeMode="System">
	<!-- ThemeMode="System": WPF's built-in Fluent (Windows 11) theme, following Windows' light/dark setting. -->
	<Application.Resources>
		<!-- Text one notch smaller than the theme's 14 (owner): the theme's control styles read their size from this resource. -->
		<sys:Double x:Key="ControlContentThemeFontSize">12</sys:Double>
	</Application.Resources>
</Application>
