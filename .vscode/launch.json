{
	// F5 = debug, Ctrl+F5 = run without debugging. Pick the configuration in the Run and Debug view (Ctrl+Shift+D).
	"version": "0.2.0",
	"configurations": [
		{
			"name": "GUI (LunaDR)",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${workspaceFolder}/src/LunaDR.Gui/bin/Debug/net10.0-windows/LunaDR.exe",
			"cwd": "${workspaceFolder}",
			"console": "internalConsole",
			"stopAtEntry": false
		},
		{
			"name": "CLI (lunadr-cli info)",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${workspaceFolder}/src/LunaDR.Cli/bin/Debug/net10.0/lunadr-cli.exe",
			// Change the arguments to run another command, e.g. ["mkv", "E:", "0", "C:\\Rips", "--dry-run"].
			"args": ["info", "E:"],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"stopAtEntry": false
		}
	]
}
